void ADC_Init(void) {
    // REFS0=1 - AVcc como referencia
    // ADLAR=1 - resultado ajustado a la izquierda, solo se usan los 8 bits altos (ADCH)
    ADMUX = (1 << REFS0) | (1 << ADLAR);
